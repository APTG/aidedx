<?xml version="1.0" encoding="utf-8"?>
<!--
  issue #161 — landscape variant. Same view IDs as res/layout/main.xml (MainActivity.kt's
  bindViews() finds every one of them by id and has no orientation-specific logic), so this file
  only changes arrangement, never functional structure: `readyPanel` becomes a horizontal split
  (record controls + benchmark on the left, the transcript/intent/result card on the right)
  instead of one long vertical stack, so a short-and-wide landscape screen doesn't squeeze
  everything into a single scrolling column. Kept under one shared ScrollView rather than two
  independently-scrolling side-by-side ScrollViews — a ScrollView nested inside another
  vertically-scrolling container is a well-known touch-handling trap (the inner one captures the
  gesture and the outer one becomes unscrollable), and landscape phone screens are short enough
  that one shared scroll is enough.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <android.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/AppToolbar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                style="@style/ToolbarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="aidedx" />

            <TextView
                android:id="@+id/captureIndicatorText"
                style="@style/MutedHintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/statusText"
                style="@style/MutedHintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </android.widget.Toolbar>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/downloadPromptPanel"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/modelInfoText"
                    style="@style/BodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="12dp" />

                <Button
                    android:id="@+id/downloadButton"
                    style="@style/Button.Accent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Download" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/downloadProgressPanel"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="@style/AppProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100" />

                <TextView
                    android:id="@+id/progressText"
                    style="@style/MutedHintText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingBottom="12dp" />

                <Button
                    android:id="@+id/cancelButton"
                    style="@style/Button.Outline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancel" />
            </LinearLayout>

            <!-- issue #161 — the only real structural change from res/layout/main.xml: readyPanel
                 is horizontal here (two side-by-side columns) instead of one vertical stack. -->
            <LinearLayout
                android:id="@+id/readyPanel"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <!-- left column: record control. The dev-only latency benchmark that used to sit
                     below it (issue #136/#143 goal 3 spike tooling) moved into the toolbar
                     overflow (issue #161) — same "secondary/infrequent action doesn't belong on
                     the primary screen" reasoning #144 already applied to "Manage downloads". -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <Button
                        android:id="@+id/recordButton"
                        style="@style/Button.Outline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎤  Tap to record"
                        android:enabled="false" />

                    <ProgressBar
                        android:id="@+id/recordProgressBar"
                        style="@style/AppProgressBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:indeterminate="true"
                        android:visibility="gone" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/border"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />

                <!-- right column: transcript/intent/result card -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:padding="14dp">

                    <TextView
                        style="@style/SectionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Transcript" />
                    <TextView
                        android:id="@+id/transcriptText"
                        style="@style/BodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp" />

                    <TextView
                        style="@style/SectionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="12dp"
                        android:text="Matched intent" />
                    <TextView
                        android:id="@+id/intentText"
                        style="@style/BodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp" />

                    <TextView
                        style="@style/SectionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="12dp"
                        android:text="Result" />
                    <TextView
                        android:id="@+id/resultText"
                        style="@style/BodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp" />

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <Button
                            android:id="@+id/saveCaptureButton"
                            style="@style/Button.Outline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="⚑ Save capture"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/captureDetailsButton"
                            style="@style/Button.Outline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="⌄ details"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/captureUndoButton"
                            style="@style/Button.Outline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Undo"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:padding="14dp">

        <TextView
            style="@style/FooterTagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="aidedx — AI-assisted range and stopping-power queries · runs on-device" />
    </LinearLayout>
</LinearLayout>
