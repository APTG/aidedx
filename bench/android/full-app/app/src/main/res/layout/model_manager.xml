<?xml version="1.0" encoding="utf-8"?>
<!-- issue #144 — reskinned to match main.xml's header/card/spacing language; the "downloaded
     regions" list content (issue #136 goal 1) is unchanged, just carries the same visual family. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <android.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/AppToolbar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:navigationIcon="@drawable/ic_back">

        <TextView
            style="@style/ToolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Downloaded models" />
    </android.widget.Toolbar>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- issue #136 goal 1 — offline-maps-style "downloaded regions" list, one entry for now. -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <TextView
                android:id="@+id/entryNameText"
                style="@style/SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/entrySizeText"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp" />

            <TextView
                android:id="@+id/entryLocationText"
                style="@style/MutedHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp" />

            <TextView
                android:id="@+id/entryStatusText"
                style="@style/MutedHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp" />

            <Button
                android:id="@+id/deleteButton"
                style="@style/Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Delete" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
