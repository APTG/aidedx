<?xml version="1.0" encoding="utf-8"?>
<!-- issue #144 — rounded-md bordered/idle button (web MicButton.svelte idle state: border-input
     bg-card). radius 6dp ~= CSS's radius-md token (calc(0.5rem - 2px)). Ripple mask reuses the same
     rounded shape so the touch feedback doesn't bleed square corners past the button's own. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/border">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <stroke android:width="1dp" android:color="@color/input" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</ripple>
