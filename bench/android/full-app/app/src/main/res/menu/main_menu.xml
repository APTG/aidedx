<?xml version="1.0" encoding="utf-8"?>
<!-- issue #144 — "Manage downloads" moves from a full-width button competing with the primary
     record action (per the issue's own suggestion) into the toolbar overflow, the native Android
     affordance for a secondary, infrequent action; the web app has no equivalent since it's a
     single-page app with no comparable "management" screen to link to. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/action_manage_downloads"
        android:title="Manage downloads"
        android:showAsAction="never" />
    <!-- issue #161 — same "secondary, infrequent action belongs in the overflow" reasoning as
         "Manage downloads" above. -->
    <item
        android:id="@+id/action_debug_captures"
        android:title="Debug captures"
        android:showAsAction="never" />
    <!-- issue #161 — moved off the main screen entirely (was a permanently-visible button+text
         block at the bottom of the result card) for the same reason: dev-only spike tooling
         (issue #136/#143 goal 3) doesn't belong competing with the primary record action. -->
    <item
        android:id="@+id/action_latency_benchmark"
        android:title="Run latency benchmark"
        android:showAsAction="never" />
</menu>
