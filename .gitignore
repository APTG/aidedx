# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# SvelteKit / Vite build output
/build
/.svelte-kit/

# misc
.DS_Store
.env
.env.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Lock files from other package managers — this project uses pnpm
package-lock.json
yarn.lock

# Local model weight cache (downloaded by prefetch scripts, not committed)
/.hf-cache/

# Android ASR runtime bench model cache + battery snapshots (issue #120,
# scripts/android-asr-fetch-models.sh / scripts/android-asr-battery-bench.sh) — same
# regenerable-artifact rationale as .hf-cache/, never committed
/.android-asr-cache/

# Recorded voice clips for the ASR eval set — local only, never committed
/eval/audio/

# Python venv for s3cmd (Cyfronet mirror tooling)
/.venv/

# Python venv for local TTS eval-audio synthesis (issue #30 pilot, docs/tts-eval-audio.md)
/.venv-tts/

# Python venv for the Qwen3-TTS feasibility check (issue #30, docs/tts-eval-audio.md §6)
/.venv-qwen/

# Python venv for Piper TTS (Polish synthesis, issue #79/#87 — scripts/tts-piper-1000.py)
/.venv-piper/

# Python venv for Chatterbox Multilingual TTS (Polish voice cloning, issue #106 —
# scripts/tts-chatterbox-1000-pl.py)
/.venv-chatterbox/

# Python bytecode cache, generated whenever a scripts/*.py file is run directly
__pycache__/

# Athena/PLGrid environment (docs/athena-setup.md, scripts/athena-env.sh) — every cache that
# would otherwise write into $HOME's 10GB quota (pip, npm, huggingface_hub) redirects here instead
/.cache/
/.npm-global/
/.hf-cache-py/

# s3cmd credentials (Cyfronet mirror tooling) — contains a live secret key, never commit
/.s3cmd
/.s3cfg

# Restaged model weights, ready for s3cmd sync — regenerated by mirror-fetch-model.ts, not committed
/mirror-staging/

# Playwright browser profile for scripts/asr-browser-benchmark.mjs (caches downloaded model weights
# across runs) — regenerated on demand, not committed
/.tmp-pw-profile*/

# 1000-sentence eval batch (issue #30): the sentence set is fully regenerable from
# scripts/generate-1000-sentences.mjs's fixed seed — not committed, same as build output.
# SLURM sbatch log files from submit.sh land at the repo root — also not committed.
/scripts/tts-1000-sentences.json
/aidedx-tts1000-*.out
/aidedx-tts1000-*.err

# v2 batch (issue #83, expanded ion/material pools + LET phrasing, submit-v2.sh) — same
# regenerable-artifact rationale as the v1 files above.
/scripts/tts-1000-sentences-v2.json
/aidedx-tts1000-v2-*.out
/aidedx-tts1000-v2-*.err

# Polish 1000-sentence batch (issue #79 Track 3, submit-pl.sh) — same regenerable-artifact
# rationale, fixed seed in generate-1000-sentences-pl.mjs.
/scripts/tts-1000-sentences-pl.json
/aidedx-tts1000-pl-*.out
/aidedx-tts1000-pl-*.err
