{
  "name": "aidedx",
  "version": "0.0.1",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --workspace src --tsconfig tsconfig.svelte-check.json && tsc --noEmit -p tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --workspace src --tsconfig tsconfig.svelte-check.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:eval": "node scripts/validate-intents.ts && node scripts/validate-datagen-sentences.ts",
    "coverage:intents": "node scripts/coverage-intents.ts",
    "bench:nlu": "node scripts/bench-nlu.ts",
    "llm:nlu-eval": "node scripts/llm-nlu-eval.ts",
    "generate:aliases": "node scripts/generate-aliases.ts",
    "generate:lexicon": "node scripts/generate-lexicon.ts",
    "bench:asr-browser": "node scripts/asr-browser-benchmark.mjs",
    "asr:transcribe": "node scripts/asr-transcribe.mjs",
    "asr:score": "node scripts/asr-score-slots.mjs",
    "eval:e2e": "node scripts/e2e-audio-intents.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.9",
    "@sveltejs/kit": "^2.69.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^26.1.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.0.1",
    "sherpa-onnx-node": "1.13.4",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "pnpm": {
    "overrides": {
      "onnxruntime-web": "1.27.0",
      "adm-zip": ">=0.6.0",
      "cookie": ">=0.7.0 <1"
    }
  }
}
